/* pages/meditate/meditate.wxss - 柔和奶油暖色系（与首页/开屏海报品牌色统一）
   色板：底色 #F7F2EA 奶油 · 卡片 #FFFDF8 象牙白
   主点缀 #7E9B77 抹茶绿 · 暖点缀 #C89268 暖驼
   文字 #574E42 暖棕 · 次文字 #9C9184 灰驼 */
.page {
  min-height: 100vh;
  position: relative;
  display: flex;
  flex-direction: column;
  padding: 60rpx 40rpx 48rpx;
  box-sizing: border-box;
  overflow: hidden;
  background: #F7F2EA;
}

/* 柔和光晕背景：抹茶绿 + 暖驼淡晕（呼应开屏海报的晨光感） */
.stars {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background:
    radial-gradient(120% 80% at 50% 0%, rgba(126, 155, 119, 0.10), rgba(126, 155, 119, 0) 60%),
    radial-gradient(120% 80% at 50% 100%, rgba(200, 146, 104, 0.10), rgba(200, 146, 104, 0) 55%),
    linear-gradient(180deg, #F7F2EA 0%, #F4EEE4 100%);
  z-index: -1;
}

/* 顶部禅语 */
.top { text-align: center; margin-bottom: 40rpx; }
.quote {
  font-size: 34rpx;
  color: #C89268;
  letter-spacing: 2rpx;
  line-height: 1.8;
}
.elapsed {
  font-size: 26rpx;
  color: #9C9184;
  margin-top: 20rpx;
}

/* 中部呼吸圆环：4-4-4 节奏（吸气4s放大→屏息4s→呼气4s缩小） */
.center {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
}
.breath-ring {
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(126, 155, 119, 0.32);
  display: flex;
  justify-content: center;
  align-items: center;
  animation: breath 12s ease-in-out infinite;
}
.breath-core {
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(126, 155, 119, 0.22), rgba(126, 155, 119, 0.06));
  display: flex;
  justify-content: center;
  align-items: center;
  animation: breathCore 12s ease-in-out infinite;
}
.breath-text {
  font-size: 30rpx;
  color: #6B8A66;
  letter-spacing: 6rpx;
}
/* 吸气放大 → 屏息保持 → 呼气缩小，12s 一个循环 */
@keyframes breath {
  0%   { transform: scale(0.85); }
  33%  { transform: scale(1.1); }
  66%  { transform: scale(1.1); }
  100% { transform: scale(0.85); }
}
@keyframes breathCore {
  0%   { transform: scale(0.9); opacity: 0.7; }
  33%  { transform: scale(1.05); opacity: 1; }
  66%  { transform: scale(1.05); opacity: 1; }
  100% { transform: scale(0.9); opacity: 0.7; }
}

/* 底部控制区 */
.bottom { margin-top: 40rpx; }

/* 栏目标题（疗愈音乐 / 语音引导 / 感恩日记：三大板块统一字号，醒目柔和） */
.list-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #8A7F70;
  letter-spacing: 3rpx;
  margin-bottom: 18rpx;
}

/* 音乐横滑列表 */
.track-list { white-space: nowrap; margin-bottom: 28rpx; }
.track-item {
  display: inline-block;
  padding: 20rpx 32rpx;
  margin-right: 20rpx;
  background: #FFFDF8;
  border: 1rpx solid rgba(156, 145, 132, 0.22);
  border-radius: 20rpx;
  min-width: 180rpx;
}
.track-on {
  background: rgba(126, 155, 119, 0.14);
  border-color: rgba(126, 155, 119, 0.5);
}
.track-name { font-size: 30rpx; color: #574E42; }
.track-desc { font-size: 22rpx; color: #9C9184; margin-top: 6rpx; }

/* 第三板块：感恩日记（与音乐、引导并列的静坐后书写区） */
.grat-card {
  background: #FFFDF8;
  border-radius: 24rpx;
  padding: 28rpx 28rpx 24rpx;
  margin-bottom: 28rpx;
  border: 1rpx solid rgba(200, 146, 104, 0.22);
}
.grat-input {
  width: 100%;
  min-height: 96rpx;
  font-size: 28rpx;
  color: #574E42;
  line-height: 1.8;
  box-sizing: border-box;
}
.grat-ph { color: #B3A99B; }
.grat-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}
.grat-count { font-size: 22rpx; color: #9C9184; }
.grat-save {
  font-size: 26rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #D9A87C, #C89268);
  border-radius: 100rpx;
  padding: 10rpx 44rpx;
  font-weight: 500;
}
/* 最近的感恩记录（最多显示三篇；默认只露日期，点开才展开全文） */
.grat-history { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid rgba(156, 145, 132, 0.15); }
.grat-item { margin-bottom: 12rpx; }
.grat-item-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 4rpx;
}
.grat-item-date { font-size: 24rpx; color: #C89268; }
.grat-item-ops { display: flex; align-items: center; gap: 20rpx; }
.grat-item-del { font-size: 22rpx; color: #B3A99B; padding: 4rpx 12rpx; }
.grat-item-arrow {
  font-size: 26rpx;
  color: #9C9184;
  transition: transform 0.2s ease;
}
.grat-item-arrow-open { transform: rotate(180deg); }
/* 展开的全文（点日期才显示） */
.grat-item-body { padding: 4rpx 4rpx 14rpx; }
.grat-item-text {
  font-size: 26rpx;
  color: #574E42;
  line-height: 1.8;
  background: #F4EEE4;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  word-break: break-all;
}
.grat-more { font-size: 24rpx; color: #C89268; text-align: center; margin-top: 8rpx; }
.grat-empty { font-size: 24rpx; color: #9C9184; margin-top: 20rpx; text-align: center; line-height: 1.7; }

/* 播放控制行 */
.control-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 28rpx;
  align-items: center;
}
.play-btn {
  flex: 1.6;
  background: #FFFDF8;
  color: #574E42;
  font-size: 28rpx;
  border-radius: 100rpx;
  padding: 20rpx 0;
  text-align: center;
  border: 1rpx solid rgba(126, 155, 119, 0.35);
}
/* 上一首/下一首：更收敛的小按钮 */
.skip-btn {
  flex: 1;
  background: transparent;
  color: #9C9184;
  font-size: 26rpx;
  border-radius: 100rpx;
  padding: 20rpx 0;
  text-align: center;
  border: 1rpx solid rgba(156, 145, 132, 0.25);
}
.timer-picker { flex: 1; }
.timer-btn {
  width: 100%;
  box-sizing: border-box;
  background: #FFFDF8;
  color: #574E42;
  font-size: 28rpx;
  border-radius: 100rpx;
  padding: 20rpx 0;
  text-align: center;
  border: 1rpx solid rgba(126, 155, 119, 0.35);
}
/* 加载中的温和提示（不跳动、不抢视线） */
.loading-hint {
  font-size: 24rpx;
  color: #9C9184;
  white-space: nowrap;
}

/* 音乐进度条 */
.progress-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
}
.progress-bar {
  flex: 1;
  margin: 0;
}
.progress-time {
  font-size: 22rpx;
  color: #9C9184;
  min-width: 72rpx;
  text-align: center;
}

/* 每日陪伴顺路入口：安静的一行，不打扰静坐 */
.daily-entry {
  font-size: 24rpx;
  color: #B3A99B;
  text-align: center;
  padding: 16rpx 0;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

/* 结束按钮：暖驼渐变，呼应首页暖点缀 */
.end-btn {
  width: 100%;
  font-size: 32rpx;
  background: linear-gradient(135deg, #D9A87C, #C89268);
  color: #FFFFFF;
  font-weight: 500;
  border-radius: 100rpx;
  padding: 26rpx 0;
  letter-spacing: 4rpx;
  box-shadow: 0 10rpx 28rpx rgba(200, 146, 104, 0.3);
}
.end-btn::after { border: none; }
