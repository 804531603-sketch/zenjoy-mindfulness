/* pages/gratitude/gratitude.wxss - 柔和奶油浅色系（与首页/关于页一致） */
.page {
  min-height: 100vh;
  padding: 48rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 顶部引导语 */
.hero { text-align: center; margin-bottom: 40rpx; }
.hero-title {
  font-size: 40rpx;
  font-weight: 500;
  color: #6B8A66;
  letter-spacing: 2rpx;
}
.hero-sub {
  font-size: 26rpx;
  color: #9C9184;
  margin-top: 16rpx;
  line-height: 1.7;
}

/* 今天的书写区 */
.write-card {
  background: #FFFDF8;
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 28rpx rgba(122, 106, 84, 0.08);
  border: 1rpx solid rgba(126, 155, 119, 0.18);
}
.write-input {
  width: 100%;
  min-height: 220rpx;
  font-size: 30rpx;
  color: #574E42;
  line-height: 1.8;
  box-sizing: border-box;
}
.write-ph { color: #B3A99B; }
.write-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(156, 145, 132, 0.15);
}
.char-count { font-size: 24rpx; color: #9C9184; }
.save-btn {
  font-size: 28rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #8FAF88, #7E9B77);
  border-radius: 100rpx;
  padding: 14rpx 56rpx;
  line-height: 1.4;
  font-weight: 500;
}
.save-btn::after { border: none; }

/* 历史记录 */
.history-section { margin-top: 48rpx; }
.history-title {
  font-size: 28rpx;
  color: #6B8A66;
  font-weight: 500;
  margin-bottom: 24rpx;
}
.history-item {
  background: #FFFDF8;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  position: relative;
  border: 1rpx solid rgba(200, 146, 104, 0.15);
}
.history-date { font-size: 24rpx; color: #C89268; margin-bottom: 12rpx; }
.history-text {
  font-size: 28rpx;
  color: #574E42;
  line-height: 1.8;
  padding-right: 80rpx;
}
.history-del {
  position: absolute;
  right: 32rpx;
  bottom: 28rpx;
  font-size: 22rpx;
  color: #B3A99B;
}

/* 空状态 */
.empty { text-align: center; margin-top: 120rpx; }
.empty-icon { font-size: 80rpx; color: rgba(126, 155, 119, 0.4); }
.empty-text { font-size: 30rpx; color: #574E42; margin-top: 24rpx; }
.empty-sub { font-size: 24rpx; color: #9C9184; margin-top: 12rpx; }
